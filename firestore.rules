rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin helper ─────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'admin@ipordise.com';
    }

    // ── Reviews ─────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.uid
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // ── Admin replies to reviews ─────────────────────────────────────────
    match /adminReplies/{replyId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // ── User profiles ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // ── Allow admin to list the users collection ─────────────────────────────
    match /users/{document=**} {
      allow read: if isAdmin();
    }
    // ── Orders ───────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Firebase Functions are the only authoritative order writers. They reload
      // catalogue prices and stock with Admin SDK privileges before every write.
      allow create: if false;
      // Customer tracking is handled by the server-side Firebase function.
      // Firestore rules cannot securely compare a phone/email supplied after a read.
      allow read: if isAdmin();
      // Only admin can update (status changes)
      allow update, delete: if isAdmin();
    }

    // ── Order counter (for sequential order IDs) ─────────────────────────────
    match /order_counter/{year} {
      allow read, write: if isAdmin();
    }

    // ── User orders subcollection ─────────────────────────────────────────────
    match /users/{userId}/orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
      allow read: if isAdmin();
    }

    match /_apiRateLimits/{document=**} {
      allow read, write: if false;
    }

    // Immutable operational history. Only the Firebase Admin SDK writes these
    // records; administrators may inspect them during support or fraud review.
    match /order_audit_logs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Analytics: any authenticated user (incl. anonymous) can write ────
    //               only admin can read
    match /analytics_sessions/{sid} {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    match /analytics_daily/{day} {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    match /analytics_products/{productId} {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    match /analytics_live/{docId} {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    // ── Admin config (force-logout timestamp) ────────────────────────────
    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Discount codes ───────────────────────────────────────────────────
    match /discountCodes/{code} {
      allow read: if true;           // checkout needs to validate codes
      allow write, delete: if isAdmin();
    }

    // ── Contact messages ─────────────────────────────────────────────────
    match /contactMessages/{id} {
      allow create: if true;          // anyone can send a contact form
      allow read, update, delete: if isAdmin();
    }

    // Legacy support documents are administrator-only. Customer chat uses the
    // token-authenticated Supabase support API, never a guessable document URL.
    match /supportThreads/{threadId} {
      allow read, write, delete: if isAdmin();
    }

    // ── Newsletter subscribers ───────────────────────────────────────────
    match /newsletterSubscribers/{id} {
      allow create, update: if true;  // anyone can subscribe
      allow read, delete: if isAdmin();
    }

    // ── Product overrides (admin-managed price/status overrides) ─────────
    match /productOverrides/{slug} {
      allow read: if true;            // storefront may check disabled status
      allow write, delete: if isAdmin();
    }

    // ── Products (added via admin panel — no-code product manager) ────────
    match /products/{slug} {
      allow read: if true;            // storefront reads active products
      allow write, delete: if isAdmin();
    }

  }
}
