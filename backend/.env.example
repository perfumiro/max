PORT=5050
NODE_ENV=development
ADMIN_USER=admin@ipordise.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=$2a$12$QYdK7h8NQ9G0h5AKX6nJ2u2M1zEq5Hk.2.fVZbCNj1JwK.q70YH4y
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=ipordise_admin_token
TRUST_PROXY=1
CORS_ORIGIN=http://localhost:5050,http://127.0.0.1:5050,http://localhost:3000,http://127.0.0.1:3000
ONLINE_WINDOW_MINUTES=5
DEDUP_WINDOW_SECONDS=45

# ─── EMAIL NOTIFICATIONS ──────────────────────────────────────────────────────
# Gmail SMTP — create a Gmail App Password at:
#   https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Where admin order notifications are sent (your email)
ADMIN_NOTIFY_EMAIL=you@gmail.com

# The "From" display name shown in all outgoing emails
EMAIL_FROM_NAME=IPORDISE
