EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Secure web dashboard URL. The dashboard must enforce its own staff authentication.
EXPO_PUBLIC_ADMIN_DASHBOARD_URL=https://ipordise.com/admin
# Firebase HTTPS Functions used for secure checkout, tracking, and order administration.
EXPO_PUBLIC_FIREBASE_FUNCTIONS_URL=https://europe-west3-ipordise-aef54.cloudfunctions.net
# Keep checkout and the admin panel on the same authoritative Firebase order store.
EXPO_PUBLIC_FIREBASE_ORDER_API_ENABLED=false
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
ADMIN_EMAILS=admin@example.com
# Local migration script only. Never expose this value in app or website code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY

# Supabase Edge Function secrets only. Never expose these as EXPO_PUBLIC_* values.
RESEND_API_KEY=re_YOUR_SERVER_ONLY_KEY
RESEND_FROM_EMAIL=IPORDISE Orders <orders@ipordise.com>
ORDER_NOTIFICATION_EMAIL=orders@example.com
EMAILJS_SERVICE_ID=service_8aoubkb
EMAILJS_ORDER_TEMPLATE_ID=template_YOUR_ORDER_TEMPLATE
EMAILJS_ADMIN_TEMPLATE_ID=template_YOUR_ADMIN_TEMPLATE
EMAILJS_CUSTOMER_TEMPLATE_ID=template_YOUR_CUSTOMER_TEMPLATE
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=YOUR_EMAILJS_PRIVATE_KEY
# Generate a unique random value with at least 32 characters. Server-side only.
REVIEW_VERIFICATION_SECRET=replace_with_a_long_random_server_secret
