{
  "name": "ipordise-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev": "expo start",
    "dev:web": "expo start --web",
    "dev:android": "expo start --android",
    "dev:android:tunnel": "expo start --android --tunnel",
    "web": "expo start --web",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "check:release": "node scripts/check-release-config.mjs",
    "check:api": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-catalog-api.mjs",
    "generate:catalog-snapshot": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/generate-catalog-snapshot.mjs",
    "validate:offline": "npm run check:release && npm run typecheck && npm test",
    "validate": "npm run validate:offline && npm run lint && npm run check:api && npx expo-doctor",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:web": "expo export --platform web --output-dir out",
    "build:eas": "eas build",
    "build:eas:preview": "eas build --platform android --profile preview",
    "build:eas:production": "eas build --platform android --profile production",
    "build:eas:production:all": "eas build --platform all --profile production",
    "deploy:web": "vercel --prod",
    "deploy:eas": "eas submit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.43.4",
    "eslint-config-expo": "~10.0.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.7",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "typescript": "~5.9.2"
  }
}
